; ── HDMI audio I2S receiver, external clock (PCM1808 master) ────
; BCK/LRCK are generated by the PCM1808; this program never drives them.
; Locks to the Left half of the LRCK frame, skips the 1-BCK I2S delay and
; samples 1 DATA bit per BCK rising edge. Autopush (32 bits) delivers one
; word per channel half-frame: 24-bit sample MSB-first in bits [31:8],
; bits [7:0] are I2S padding. Words alternate Left, Right, ...
; DATA, BCK, LRCK must be 3 consecutive GPIOs (in that order), IN_BASE = DATA,
; so BCK/LRCK are relative pins 1/2 and no runtime patching is needed.
; LRCK (JMP pin) is checked every word: on wrong phase the program re-locks
; on the next LRCK edge keeping the L/R order, so channels never swap.

.program pio_i2s_rx
PUBLIC start:
    wait    1 pin, 2                ; ensure Right half first
l_lresync:
    wait    0 pin, 2                ; LRCK falling edge = start of Left word
    wait    1 pin, 1                ; skip 1-BCK I2S delay
    wait    0 pin, 1                ; re-arm after skip
l_lword:
    set     x, 30                   ; 31 bits here + the 32nd below
l_lbit:
    wait    1 pin, 1                ; sample DATA on BCK rising edge
    in      pins, 1                 ; capture DATA bit (MSB first)
    wait    0 pin, 1                ; re-arm for next bit
    jmp     x--, l_lbit
    wait    1 pin, 1                ; 32nd bit
    in      pins, 1                 ; autopush: Left word complete
    wait    0 pin, 1
    jmp     pin, l_rword            ; LRCK high = Right half, aligned
l_rresync:
    wait    1 pin, 2                ; wrong phase: wait for Right half
    wait    1 pin, 1
    wait    0 pin, 1
l_rword:
    set     x, 30                   ; 31 bits here + the 32nd below
l_rbit:
    wait    1 pin, 1
    in      pins, 1
    wait    0 pin, 1
    jmp     x--, l_rbit
    wait    1 pin, 1
    in      pins, 1                 ; autopush: Right word complete
    wait    0 pin, 1
    jmp     pin, l_lresync          ; LRCK still high: wrong phase, re-lock on Left
    jmp     l_lword
